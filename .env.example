# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# NEXT_PUBLIC_RAZORPAY_KEY_ID: Public Razorpay key id used by the checkout
# page to open the Razorpay hosted checkout dialog. Must match the key used
# by payments-service. Empty value falls back to a stubbed flow that skips
# the gateway (useful for local/dev where payments-service uses StubGateway).
NEXT_PUBLIC_RAZORPAY_KEY_ID=""

# Local backend stack defaults. Keep CHAT_PROXY_SIGNING_SECRET equal to the
# backend JWT_SECRET used by chat-message-service and chat-ws-gateway.
API_GATEWAY_URL="http://localhost:8080"
AUTH_SERVICE_URL="http://localhost:8081"
CHAT_BACKEND_URL="http://localhost:8092/v1/chat"
CHAT_PROXY_SIGNING_SECRET="local_dev_jwt_change_me"
NEXT_PUBLIC_API_BASE_URL=""
NEXT_PUBLIC_WS_BASE_URL="ws://localhost:8093"

# NEXT_PUBLIC_SITE_URL: The public web origin, no trailing slash. Channel RSS
# feeds (/posttube/channel/<handle>/feed.xml) write their channel, watch and
# self links with it; the sitemap and the page metadata use it too.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# FEED_MEDIA_BASE_URL: Server-only. The public API origin podcast apps download
# from; channel RSS feeds write every enclosure and artwork URL with it
# (dev https://api-dev.cleestudio.com, prod https://api.cleestudio.com).
# It must be the API host itself, not this web app: the /v1 proxy here streams
# media through Next and answers no HEAD. When empty the feed falls back to
# NEXT_PUBLIC_API_BASE_URL; when both are empty the feed carries no enclosures
# and no artwork (a relative URL is never written) and the server logs it once.
FEED_MEDIA_BASE_URL=""
